{
  "expo": {
    "name": "mob-app",
    "slug": "mob-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mobapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "კამერა გამოიყენება ფოტოს და ვიდეოს გადასაღებად.",
          "microphonePermission": "მიკროფონი გამოიყენება ვიდეოს ჩასაწერად.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "გალერეა გამოიყენება გადაღებული ფაილის შესანახად.",
          "savePhotosPermission": "გალერეა გამოიყენება გადაღებული ფაილის შესანახად."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "კონტაქტები გამოიყენება სიის საჩვენებლად."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
